# Alpha-Wiki Agent Factory — TaskWorkflow worker.
# Install to /etc/systemd/system/, then: systemctl daemon-reload
# Requires: /etc/alpha-wiki/factory.env (0600, root), release at
# /opt/alpha-wiki-factory/current, venv at /opt/alpha-wiki-factory/current-venv.

[Unit]
Description=Alpha-Wiki Agent Factory worker (task queue factory-code)
Documentation=file:///opt/alpha-wiki-factory/current/factory/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/opt/alpha-wiki-factory/current/factory
EnvironmentFile=/etc/alpha-wiki/factory.env
Environment=HOME=/var/lib/alpha-wiki-factory/home
ExecStart=/opt/alpha-wiki-factory/current-venv/bin/python -m agent_factory.worker
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=alpha-wiki-factory
StateDirectoryMode=0700
ReadWritePaths=/var/lib/alpha-wiki-factory/state /var/lib/alpha-wiki-factory/work /var/lib/alpha-wiki-factory/home
CPUQuota=200%
MemoryMax=4G
Nice=10
IOWeight=100
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alpha-wiki-factory-worker

[Install]
WantedBy=multi-user.target
