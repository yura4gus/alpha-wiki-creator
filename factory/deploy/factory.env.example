# Sanitized template. Install as /etc/alpha-wiki/factory.env with mode 0600 root:root.
# Never commit a real API key. Keep this file out of shell history and chat.
TEMPORAL_ADDRESS=<namespace>.<region>.tmprl.cloud:7233
TEMPORAL_NAMESPACE=<namespace>
TEMPORAL_TLS=true
TEMPORAL_API_KEY=<read from the secret store; do not commit>

FACTORY_STATE_DIR=/var/lib/alpha-wiki-factory/state
FACTORY_WORK_ROOT=/var/lib/alpha-wiki-factory/work
FACTORY_PLUGIN_ROOT=/opt/alpha-wiki-factory/current
FACTORY_TASK_QUEUE=factory-code
FACTORY_HARNESS_TASK_QUEUE=factory-coordinator
FACTORY_MAX_ACTIVITIES=4

UV_PROJECT_ENVIRONMENT=/opt/alpha-wiki-factory/current-venv
PYTHONDONTWRITEBYTECODE=1
PATH=/opt/alpha-wiki-factory/current-venv/bin:/usr/local/bin:/usr/bin:/bin
